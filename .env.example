# ============================================================
#  PREDICTION MARKET BOT — CONFIGURATION
#  Copy this file to .env and fill in your credentials.
#  NEVER commit .env to git — it contains private keys.
# ============================================================


# ── Bot behavior ─────────────────────────────────────────────
# Which platforms to use: kalshi, polymarket, or both
PLATFORMS=kalshi,polymarket

# Strategy: arb | edge | maker | all
BOT_MODE=all

# Max $ per single trade leg
MAX_POSITION_USD=25

# Daily loss limit — bot pauses if this is hit
DAILY_LOSS_LIMIT_USD=100

# Min arbitrage gap % to fire (after fees)
ARB_MIN_EDGE_PCT=2.0

# Min model vs market deviation % for edge hunting
EDGE_MIN_DEVIATION_PCT=5.0

# Fractional Kelly sizing (0.25 = quarter Kelly — recommended)
KELLY_FRACTION=0.25

LOG_LEVEL=INFO


# ── Kalshi credentials ────────────────────────────────────────
# 1. Go to https://kalshi.com/account/profile
# 2. Scroll to "API Keys" section
# 3. Click "Create New API Key"
# 4. Copy the Key ID here and save the .pem file to keys/kalshi_private.pem

KALSHI_API_KEY_ID=your_key_id_here
KALSHI_PRIVATE_KEY_PATH=keys/kalshi_private.pem

# IMPORTANT: Start with demo=true to test without real money!
# Demo URL: demo-api.kalshi.co (separate account at demo.kalshi.co)
KALSHI_DEMO_MODE=true


# ── Polymarket credentials ────────────────────────────────────
# HOW TO GET YOUR PRIVATE KEY:
#   Option A (email/Google account):
#     1. Log in to polymarket.com
#     2. Click "Cash" (bottom of screen)
#     3. Click the three-dot menu (...)
#     4. Click "Export Private Key"
#     5. Paste it below (starts with 0x)
#
#   Option B (MetaMask):
#     1. Open MetaMask
#     2. Account Details > Export Private Key
#
# HOW TO GET YOUR FUNDER ADDRESS:
#     1. Go to https://polymarket.com/settings
#     2. Copy the wallet address shown there
#     NOTE: This is NOT always your MetaMask address!

POLYMARKET_PRIVATE_KEY=0xyour_private_key_here
POLYMARKET_FUNDER_ADDRESS=0xyour_funder_address_here
